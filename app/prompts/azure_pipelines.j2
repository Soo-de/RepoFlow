  branches:
    include:
    - {{ analysis.default_branch }}
  paths:
    include:
    - '**'
pr:
  branches:
    include:
    - {{ analysis.default_branch }}
  paths:
    include:
    - '**'
stages:
- stage: CI
  displayName: 'CI'
  jobs:
  - job: <JobName>
    displayName: '<DisplayName>'
    pool:
      vmImage: 'ubuntu-latest'
    variables:
{% if analysis.cache_env_var %}
      {{ analysis.cache_env_var }}: {{ analysis.cache_path }}
{% endif %}
    steps:
      <steps go here>

