{% if analysis.install_command %}c. Install dependencies: `{{ analysis.install_command }}`{% endif %}
{% if analysis.build_command %}d. Build: `{{ analysis.build_command }}`{% endif %}
{% if analysis.test_command %}e. Run tests: `{{ analysis.test_command }}`.
